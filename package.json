{
  "name": "metrx-hardware-monitor",
  "displayName": "Metrx",
  "version": "0.0.0-dev",
  "description": "Monitor computer information on Windows, MacOS or Linux in an Electron application",
  "main": "./out/main/index.js",
  "author": "TheRedfoox",
  "homepage": "https://www.electronjs.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "start-beta": "electron-vite preview --mode beta",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win --config",
    "build:mac": "yarn build && electron-builder --mac --config",
    "build:linux": "yarn build && electron-builder --linux --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tabler/icons-vue": "^3.50.0",
    "@tailwindcss/postcss": "^4.3.4",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "lodash": "^4.18.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "postcss": "^8.5.32",
    "stateful-electron-window": "^1.0.0",
    "systeminformation": "^5.33.19",
    "tailwindcss": "^4.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-chartjs": "^5.3.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "electron": "^45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "less": "^4.9.1",
    "naive-ui": "2.45.3",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "vfonts": "^0.0.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "yarn@4.9.1",
  "optionalDependencies": {
    "osx-temperature-sensor": "^1.0.8"
  },
  "overrides": {
    "minimatch@9.0.9": "^11.0.1",
    "minimatch@10.2.6": "^11.0.1"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "@parcel/watcher": false
  }
}
